; ─────────────────────────────────────────────
; VARIABLES & LISTENERS
; ─────────────────────────────────────────────

(deflisten clock-data :initial '{"time":"00:00","date":"","hour":"0","minute":"00","long":""}' `scripts/watch-clock.sh`)

(deflisten workspace-data :initial '{"workspaces":[],"active":1,"special":{"windows":0,"shown":false}}' `scripts/watch-workspaces.sh`)

(deflisten weather-data :initial '{"ok":false,"temperature":"","condition":"","high":"","low":"","icon":"icons/cloud.svg"}' `scripts/watch-weather.sh`)

(deflisten brightness-data :initial '{"has_brightness":"0","brightness_raw":0,"brightness_max":100}' `scripts/watch-brightness.sh`)

(deflisten mako-paused :initial "0" `scripts/watch-mako.sh`)

(deflisten kb-backlight :initial '{"present":false,"level":0,"max":0,"steps":[]}' `scripts/watch-kb-backlight.sh`)

(deflisten kb-layout :initial "" `scripts/watch-kb-layout.sh`)

(deflisten battery-data :initial '{"has_battery":0,"capacity":0,"status":"","ac":0}' `scripts/watch-battery.sh`)

(deflisten audio-data :initial '{"volume":0,"mute":"true"}' `scripts/watch-audio.sh`)

(deflisten bluetooth-data :initial '{"state":"disabled","count":0,"devices":[]}' `scripts/watch-bluetooth.sh`)

(deflisten network-data :initial '{"connection":"wifi-offline","ssid":"","vpn_active":false,"vpn_name":""}' `scripts/watch-network.sh`)

(deflisten media-data :initial '{"title":"","artist":"","status":"Stopped","art":""}' `scripts/watch-media.sh`)

(deflisten sensors-data :initial '{"cpu":0,"ram":0,"cpu_temp":0,"gpu_temp":0,"level":0,"status":"Idle"}' `scripts/watch-sensors.sh`)

; Polled rather than read once so a new ~/.face shows up without a restart.
(defpoll avatar :interval "60s" :initial '{"path":"","fallback":true}' `scripts/avatar.sh`)

; auto-cpufreq power mode (raccoon). power-mode.sh cycle also pushes the new
; value with eww update, so the poll only catches outside changes.
(defpoll power-mode :interval "10s" :initial '{"present":false,"mode":"auto"}' `scripts/power-mode.sh get`)

(defpoll whoami :interval "60s" :initial '{"name":"","host":"","uptime":""}' `scripts/whoami.sh`)

(include "menu.yuck")
(include "osd.yuck")

; ─────────────────────────────────────────────
; SHARED
; ─────────────────────────────────────────────

; User picture, painted as a background so border-radius clips it. The
; fallback glyph is centred at a smaller size instead of covering the tile.
(defwidget avatar-tile [size]
  (box
    :class "avatar ${avatar.fallback ? "avatar-fallback" : ""}"
    :width size
    :height size
    :style "background-image: url('${avatar.path}');"))

; ─────────────────────────────────────────────
; BAR WIDGETS
; ─────────────────────────────────────────────

; Workspaces as dots: dim = empty, bright = has windows, tall = active.
; Scrolling anywhere on the workspace group cycles the bar monitor's stack
; (wraps, never opens a new workspace).
(defwidget bar-workspaces []
  (eventbox
    :onscroll "~/.config/hypr/scripts/workspace-cycle.sh {} --monitor $(scripts/get-screen.sh name) --no-new &"
  (box
    :class "bar-workspaces"
    :orientation "v"
    :space-evenly false
    :spacing 4
    ; SUPER + S special workspace, pinned first so it never moves as
    ; numbered workspaces come and go.
    (button
      :class "bar-icon-btn ws-special ${workspace-data.special.shown ? "ws-special-shown" : workspace-data.special.windows > 0 ? "ws-special-occupied" : ""}"
      :tooltip "Special workspace (SUPER + S)"
      :onclick "scripts/goto-workspace.sh special:magic &"
      (image :path "icons/stack.svg" :image-width 16 :image-height 16))
    ; the `for` lives in its own box: eww lays out a box's literal children
    ; before loop-generated ones, so a bare sibling button would jump above
    ; the workspace list instead of trailing it.
    (box
      :class "ws-dots"
      :orientation "v"
      :space-evenly false
      :spacing 0
      (for ws in {workspace-data.workspaces}
        (button
          :class "ws-btn ${ws.id == workspace-data.active ? "ws-active" : ws.windows > 0 ? "ws-occupied" : "ws-empty"}"
          :tooltip "Workspace ${ws.id}"
          :onclick "scripts/goto-workspace.sh ${ws.id} &"
          (box :class "ws-dot" :halign "center" :valign "center"))))
    (button
      :class "bar-icon-btn ws-add"
      :tooltip "New workspace (SUPER + Down past the last)"
      :onclick "~/.config/hypr/scripts/workspace-cycle.sh new --monitor $(scripts/get-screen.sh name) &"
      (image :path "icons/plus.svg" :image-width 14 :image-height 14)))))

(defwidget bar-volume []
  (button
    :class "bar-icon-btn ${audio-data.mute == "true" ? "bar-icon-muted" : ""}"
    :tooltip "Volume: ${audio-data.volume}%. Click to mute, scroll to change"
    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle &"
    ; same script as the volume keys, so it also shows the OSD; {} is up/down
    :onscroll "~/.config/hypr/scripts/volume-notify.sh {} 2% &"
    (image
      :path {audio-data.mute == "true"
        ? "icons/speaker-simple-x.svg"
        : (audio-data.volume ?: 0) == 0
        ? "icons/speaker-simple-none.svg"
        : (audio-data.volume ?: 0) < 50
        ? "icons/speaker-simple-low.svg"
        : "icons/speaker-simple-high.svg"}
      :image-width 16
      :image-height 16)))

(defwidget bar-battery []
  (box
    :class "bar-battery ${battery-data.capacity < 20 && battery-data.ac != 1 ? "battery-low" : ""}"
    :orientation "v"
    :visible {battery-data.has_battery == 1}
    :tooltip "Battery: ${battery-data.capacity}%${battery-data.ac == 1 ? ", charging" : ""}"
    :space-evenly false
    :spacing 2
    (image
      :path {battery-data.ac == 1 ? "icons/battery-charging.svg"
        : battery-data.capacity < 15 ? "icons/battery-empty.svg"
        : battery-data.capacity < 40 ? "icons/battery-low.svg"
        : battery-data.capacity < 65 ? "icons/battery-medium.svg"
        : battery-data.capacity < 90 ? "icons/battery-high.svg"
        : "icons/battery-full.svg"}
      :image-width 16
      :image-height 16)
    (label :class "bar-small-label" :text "${battery-data.capacity}")))

; Only shown while a power mode is forced; Auto keeps the bar unchanged.
(defwidget bar-power-mode []
  (button
    :class "bar-icon-btn"
    :visible {power-mode.present && power-mode.mode != "auto"}
    :tooltip {power-mode.mode == "powersave" ? "Power saver (forced). Click to change" : "Performance (forced). Click to change"}
    :onclick "scripts/power-mode.sh cycle &"
    (image
      :path {power-mode.mode == "powersave" ? "icons/leaf.svg" : "icons/speedometer.svg"}
      :image-width 16
      :image-height 16)))

; Hour over minute, upright: easier to read than a rotated "1:52 PM".
(defwidget bar-clock []
  (box
    :class "bar-clock"
    :orientation "v"
    :space-evenly false
    :tooltip {clock-data.long}
    (label :class "bar-clock-h" :text {clock-data.hour})
    (label :class "bar-clock-m" :text {clock-data.minute})))

(defwidget bar-menu-btn []
  (button
    :class "bar-menu-btn ${menu-open ? "bar-menu-open" : ""}"
    :tooltip "Quick menu (SUPER + X)"
    :onclick "scripts/toggle-menu.sh &"
    (avatar-tile :size 30)))

; ─────────────────────────────────────────────
; BAR LAYOUT
; ─────────────────────────────────────────────

; The window is transparent and full-height; the visible rail is .bar-rail,
; inset by its margin so it floats. (Not "bar": eww classes the GTK window
; after its name, so a .bar rule would paint the window as well.) Hyprland blurs only the opaque part
; (ignore_alpha on the eww-bar layer rule).

(defwidget bar [?on_laptop]
  (box
    :class "bar-rail ${on_laptop == "true" ? "bar-laptop" : ""}"
    :orientation "v"
    :space-evenly false
    :hexpand false

    (box
      :class "bar-top"
      :orientation "v"
      :space-evenly false
      :vexpand true
      :valign "start"
      (bar-workspaces))

    ; Three groups read by spacing alone: tight inside (tray icons 24px
    ; apart), wide between (20px): tray, system (volume + battery), clock,
    ; then the avatar.
    (box
      :class "bar-bottom"
      :orientation "v"
      :space-evenly false
      :valign "end"
      :spacing 20
      (systray
        :class "systray"
        :orientation "v"
        :space-evenly false
        :spacing 0
        :icon-size 16)
      (box :orientation "v" :space-evenly false :spacing 0
        (bar-volume)
        (bar-battery)
        (bar-power-mode))
      (bar-clock)
      (bar-menu-btn))))

; ─────────────────────────────────────────────
; BAR WINDOW
; ─────────────────────────────────────────────

; Width = 7px left margin + rail (48, or 52 on the laptop panel). The rail's
; right edge sits on the reserved zone; Hyprland's gaps_out (7) puts windows,
; the menu and the OSD the same distance away.
(defwindow bar [?on_laptop]
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "${on_laptop == "true" ? "59" : "55"}px"
    :height "100%"
    :anchor "left center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar :on_laptop on_laptop))
