; ─────────────────────────────────────────────
; VARIABLES & LISTENERS
; ─────────────────────────────────────────────

(deflisten clock-data :initial '{"time":"00:00","date":""}' `scripts/watch-clock.sh`)

(deflisten workspace-data :initial '{"workspaces":[],"active":1}' `scripts/watch-workspaces.sh`)

(deflisten weather-data :initial '{"temperature":"","icon":""}' `scripts/watch-weather.sh`)

(deflisten brightness-data :initial '{"has_brightness":"0","brightness_raw":0,"brightness_max":100}' `scripts/watch-brightness.sh`)

(deflisten mako-paused :initial "0" `scripts/watch-mako.sh`)

(deflisten has-kb-backlight :initial "0" `scripts/watch-kb-backlight.sh`)

(deflisten kb-layout :initial "" `scripts/watch-kb-layout.sh`)

(deflisten battery-data :initial '{"has_battery":0,"capacity":0,"status":"","ac":0}' `scripts/watch-battery.sh`)

(deflisten audio-data :initial '{"volume":0,"mute":"true"}' `scripts/watch-audio.sh`)

(deflisten bluetooth-data :initial '{"state":"disabled","device":""}' `scripts/watch-bluetooth.sh`)

(deflisten network-data :initial '{"connection":"wifi-offline","ssid":"","vpn_active":false,"vpn_name":""}' `scripts/watch-network.sh`)

(deflisten active-window :initial "" `scripts/watch-active-window.sh`)

(deflisten media-data :initial '{"title":"","artist":"","status":"Stopped","art":""}' `scripts/watch-media.sh`)

(deflisten sensors-data :initial '{"cpu":0,"ram":0,"cpu_temp":0,"gpu_temp":0}' `scripts/watch-sensors.sh`)

(include "menu.yuck")
(include "osd.yuck")

; ─────────────────────────────────────────────
; BAR WIDGETS
; ─────────────────────────────────────────────



(defwidget bar-active-window []
  (label
    :class "bar-active-window"
    :angle 90
    :halign "start"
    :truncate true
    :limit-width 28
    :text {active-window == "" ? "~" : active-window}))

(defwidget bar-workspaces []
  (box
    :class "bar-workspaces"
    :orientation "v"
    :space-evenly false
    :spacing 0
    (for ws in {workspace-data.workspaces}
      (button
        :class "ws-btn ${ws.id == workspace-data.active ? "ws-active" : ws.windows > 0 ? "ws-occupied" : "ws-empty"}"
        :onclick "hyprctl dispatch workspace ${ws.id}"
        (label :angle 90 :text "${ws.id}")))))

(defwidget bar-mic []
  (box :class "bar-mic-dot ${false ? "mic-active" : "mic-off"}"
       :halign "center"))

(defwidget bar-volume []
  (button
    :class "bar-icon-btn"
    :tooltip "Volume: ${audio-data.volume}%  —  click to mute"
    :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle &"
    :onscroll "scripts/scroll-volume.sh {} &"
    (image
      :path {audio-data.mute == "true"
        ? "icons/speaker-simple-x.svg"
        : (audio-data.volume ?: 0) == 0
        ? "icons/speaker-simple-none.svg"
        : (audio-data.volume ?: 0) < 50
        ? "icons/speaker-simple-low.svg"
        : "icons/speaker-simple-high.svg"}
      :image-width 14
      :image-height 14)))

(defwidget bar-battery []
  (box
    :class "bar-battery"
    :orientation "v"
    :visible {battery-data.has_battery == 1}
    :halign "center"
    :spacing 3
    (progress
      :class "battery-progress ${battery-data.capacity < 20 ? "battery-low" : battery-data.ac == 1 ? "battery-charging" : ""}"
      :orientation "v"
      :flipped true
      :value {battery-data.capacity}
      :min 0
      :max 100)
    (label
      :class "bar-small-label"
      :angle 90
      :text "${battery-data.capacity}%")))

(defwidget bar-dnd []
  (button
    :class "bar-dnd-dot ${mako-paused == "1" ? "dnd-active" : "dnd-off"}"
    :tooltip {mako-paused == "1" ? "DND on — click to disable" : "DND off — click to enable"}
    :onclick "makoctl mode -t do-not-disturb &"))

(defwidget bar-clock []
  (box
    :orientation "v"
    :halign "center"
    :spacing 2
    :space-evenly false
    (label :class "bar-time" :angle 90 :text {clock-data.time})
    (label :class "bar-day"  :angle 90 :text {substring(clock-data.date, 0, 3)})))

(defwidget bar-menu-btn []
  (button
    :class "bar-menu-btn"
    :onclick "scripts/toggle-menu.sh &"
    (image :path "icons/squares-four.svg" :image-width 13 :image-height 13)))

; ─────────────────────────────────────────────
; BAR LAYOUT
; ─────────────────────────────────────────────

(defwidget bar []
  (box
    :class "bar"
    :orientation "v"
    :space-evenly false
    :hexpand false

    ; ── top section: window title + workspaces
    (box
      :class "bar-top"
      :orientation "v"
      :space-evenly false
      :vexpand true
      :valign "start"
      (bar-active-window)
      (box :class "bar-divider")
      (bar-workspaces))

    ; ── bottom section: status + menu
    (box
      :class "bar-bottom"
      :orientation "v"
      :space-evenly false
      :valign "end"
      :spacing 0
      (systray
            :class "systray"
            :orientation "v"
            :space-evenly true
            :icon-size 15)
      (box :class "bar-divider")
      (bar-volume)
      (bar-battery)
      (box :class "bar-divider")
      (bar-clock)
      (box :class "bar-divider")
      (bar-menu-btn))))

; ─────────────────────────────────────────────
; BAR WINDOW
; ─────────────────────────────────────────────

(defwindow bar
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "36px"
    :height "100%"
    :anchor "left center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar))
