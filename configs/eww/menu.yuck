; ─────────────────────────────────────────────
; QUICK MENU — menu.yuck
; ─────────────────────────────────────────────

; ── Two windows opened/closed together (see toggle-menu.sh / close-menu.sh):
; the scrim gets its own blurred layer that just fades in place, while the
; panel keeps a separate layer so it can pop in beside the bar.

; Full-screen click catcher; Hyprland blurs what's behind it (layer rule on
; the eww-*-scrim namespaces).
;
; Its x is measured from the bar's reserved zone, so at 0 it would stop at
; the bar and leave the strip under it sharp. The negative offset and 110%
; width reach back under the bar, and still cover the whole screen on
; monitors without one.
(defwidget scrim [onclick]
  (eventbox
    :onclick onclick
    :onrightclick onclick
    :onmiddleclick onclick
    :hexpand true
    :vexpand true
    (box :class "scrim-box" :hexpand true :vexpand true)))

(defwindow menu_scrim
  :monitor 0
  :geometry (geometry
    :x "-80px"
    :y "0px"
    :width "110%"
    :height "100%"
    :anchor "left center")
  :stacking "fg"
  :namespace "eww-menu-scrim"
  (scrim :onclick "scripts/close-menu.sh &"))

; Same scrim behind wofi — opened/closed by hypr/scripts/wofi.sh. A click
; kills wofi, and the wrapper closes the scrim once wofi is gone.
(defwindow wofi_scrim
  :monitor 0
  :geometry (geometry
    :x "-80px"
    :y "0px"
    :width "110%"
    :height "100%"
    :anchor "left center")
  :stacking "fg"
  :namespace "eww-wofi-scrim"
  (scrim :onclick "pkill -x wofi &"))

; A full-height card beside the bar. Like the bar, the window is
; transparent and the card floats inside it on an 8px top/bottom margin.
; x is measured from the bar's reserved zone, not the screen edge, so 8px
; (Hyprland's gaps_out) puts it exactly where a tiled window starts. Clicks
; beside it land on the scrim, which closes the menu.
(defwindow menu_overlay
  :monitor 0
  :geometry (geometry
    :x "8px"
    :y "0px"
    :width "340px"
    :height "100%"
    :anchor "left center")
  :stacking "fg"
  :namespace "eww-menu"
  (quick-menu-content))

; Whether the menu is open — set by toggle-menu.sh / close-menu.sh so the
; bar's menu button can show an active state.
(defvar menu-open false)

(defvar cal-month 1)
(defvar cal-year 2024)
(defpoll cal-today :interval "3600s" `date +%-d`)

; ── Panel content
;
; No dividers: sections are separated by the panel's spacing alone.

(defwidget quick-menu-content []
  (box
    :class "quick-menu"
    :orientation "v"
    :space-evenly false
    :vexpand true
    :spacing 22
    (qm-header)
    (qm-weather)
    (qm-actions)
    (qm-media)
    (qm-sliders)
    (qm-connectivity)
    (qm-status)
    ; calendar sits at the bottom of the card
    (box :vexpand true)
    (qm-calendar)))

; ── Who + when

(defwidget qm-header []
  (box :orientation "v" :space-evenly false :spacing 18
    (box :orientation "h" :space-evenly false :spacing 12
      (avatar-tile :size 40)
      (box :orientation "v" :space-evenly false :valign "center" :spacing 1
        (label :class "qm-name" :halign "start" :text {whoami.name})
        (label :class "qm-host" :halign "start" :text "${whoami.host} · up ${whoami.uptime}")))
    ; date on its own label: it must never depend on the weather feed
    (box :orientation "v" :space-evenly false :spacing 4
      (label :class "qm-time" :halign "start" :text {clock-data.time})
      (label :class "qm-date" :halign "start" :text {clock-data.long}))))

; ── Weather: icon, temperature, condition and today's range. Hidden until
; the first successful fetch; click opens the forecast in the browser.

(defwidget qm-weather []
  (button
    :class "qm-row-btn"
    :visible {weather-data.ok == true}
    :tooltip "Open the forecast in the browser"
    :onclick "(scripts/close-menu.sh; xdg-open 'https://weather.com/weather/today/l/-29.59,-51.16') &"
    (box :orientation "h" :space-evenly false :spacing 12
      (image :path {weather-data.icon} :image-width 22 :image-height 22)
      (label :class "qm-weather-temp" :text {weather-data.temperature})
      (box :orientation "v" :space-evenly false :spacing 1 :valign "center" :hexpand true
        (label :class "qm-tile-title" :halign "start" :xalign 0 :text {weather-data.condition})
        (label :class "qm-tile-sub" :halign "start" :xalign 0
          :text "High ${weather-data.high} · Low ${weather-data.low}"))
      (image :class "qm-dim-icon" :path "icons/caret-right.svg" :image-width 13 :image-height 13))))

; ── Actions: lock / restart / power / screenshot (DND is a tile below)

(defwidget qm-action [icon tooltip onclick ?active]
  (button
    :class "qm-action-btn ${active == "true" ? "qm-on" : ""}"
    :hexpand true
    :tooltip tooltip
    :onclick onclick
    (image :path "icons/${active == "true" ? "dark/" : ""}${icon}.svg" :image-width 18 :image-height 18)))

(defwidget qm-actions []
  (box :class "qm-actions" :orientation "h" :space-evenly true :spacing 8
    (qm-action :icon "lock" :tooltip "Lock screen" :onclick "hyprlock &")
    (qm-action :icon "arrow-counter-clockwise" :tooltip "Restart" :onclick "systemctl reboot &")
    (qm-action :icon "power" :tooltip "Power off" :onclick "shutdown -h now &")
    ; close the menu first and let the scrim's fade-out (~200ms) finish, or
    ; the capture has the menu and blur in it
    (qm-action :icon "camera" :tooltip "Screenshot to clipboard"
      :onclick "(scripts/close-menu.sh; sleep 0.4; hyprshot -m output --clipboard-only) &")))

; ── Media player: art, title / artist, controls on one row

(defwidget qm-media []
  (box
    :class "qm-media"
    :orientation "h"
    :space-evenly false
    :spacing 12
    :visible {media-data.title != ""}

    ; painted as a background (not an image widget) so border-radius clips it
    (box
      :class "qm-media-art ${media-data.art == "" ? "qm-media-art-empty" : ""}"
      :valign "center"
      :style {media-data.art != "" ? "background-image: url('${media-data.art}');" : ""})

    (box :orientation "v" :space-evenly false :spacing 2 :hexpand true :valign "center"
      (label :class "qm-media-title" :halign "start" :xalign 0
        :truncate true :limit-width 18 :text {media-data.title})
      (label :class "qm-media-artist" :halign "start" :xalign 0
        :truncate true :limit-width 22 :text {media-data.artist}))

    (box :orientation "h" :space-evenly false :spacing 2 :valign "center"
      (button :class "qm-media-btn" :onclick "playerctl previous &"
        (image :path "icons/skip-back.svg" :image-width 14 :image-height 14))
      (button :class "qm-media-btn qm-media-btn-play" :onclick "playerctl play-pause &"
        (image
          :path {media-data.status == "Playing" ? "icons/dark/pause.svg" : "icons/dark/play.svg"}
          :image-width 14 :image-height 14))
      (button :class "qm-media-btn" :onclick "playerctl next &"
        (image :path "icons/skip-forward.svg" :image-width 14 :image-height 14)))))

; ── Sliders: volume / brightness (also used by the OSD windows)
;
; :max is 101 because eww builds the GtkAdjustment with a page size of 1, so
; the top is only reachable at max - 1. :round-digits 0 keeps the value
; handed to onchange an integer instead of e.g. 99.6.

(defwidget volume-slider []
    (box :class "qm-slider-row" :orientation "h" :space-evenly false :spacing 12 :halign "fill"
      (image
        :path {audio-data.mute == "true"
          ? "icons/speaker-simple-x.svg"
          : (audio-data.volume ?: 0) == 0
          ? "icons/speaker-simple-none.svg"
          : (audio-data.volume ?: 0) < 50
          ? "icons/speaker-simple-low.svg"
          : "icons/speaker-simple-high.svg"}
        :image-width 16 :image-height 16)
      (scale
        :class "qm-slider"
        :min 0 :max 101 :round-digits 0
        :value {audio-data.volume}
        :onchange "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ {}% &"
        :orientation "h"
        :hexpand true)
      (label :class "qm-slider-value" :xalign 1 :text "${audio-data.volume}")))

(defwidget brightness-slider []
    (box :class "qm-slider-row" :orientation "h" :space-evenly false :spacing 12 :halign "fill"
      :visible {brightness-data.has_brightness == "1" && brightness-data.brightness_max > 0}
      (image
        :path {round((brightness-data.brightness_raw * 100.0) / brightness-data.brightness_max, 0) > 30
          ? "icons/sun.svg" : "icons/moon.svg"}
        :image-width 16 :image-height 16)
      (scale
        :class "qm-slider"
        :min 0 :max 101 :round-digits 0
        :value {round((brightness-data.brightness_raw * 100.0) / brightness-data.brightness_max, 0)}
        :onchange "brightnessctl set {}% &"
        :orientation "h"
        :hexpand true)
      (label :class "qm-slider-value" :xalign 1
        :text "${round((brightness-data.brightness_raw * 100.0) / brightness-data.brightness_max, 0)}")))

(defwidget qm-sliders []
  (box :class "qm-sliders" :orientation "v" :space-evenly false :spacing 6
    (volume-slider)
    (brightness-slider)))

; ── Connectivity: wifi / bluetooth / vpn / keyboard backlight
;
; Two-line tiles. A tile that's on turns white (icons switch to icons/dark/).
; limit-width keeps long SSIDs / device names from widening the panel.

(defwidget qm-tile [icon title sub on tooltip onclick]
  (button
    :class "qm-tile ${on ? "qm-on" : ""}"
    :hexpand true
    :tooltip tooltip
    :onclick onclick
    (box :orientation "h" :space-evenly false :spacing 10
      (image :path "icons/${on ? "dark/" : ""}${icon}.svg" :image-width 18 :image-height 18)
      (box :orientation "v" :space-evenly false :spacing 1 :valign "center"
        (label :class "qm-tile-title" :halign "start" :xalign 0 :text title)
        (label :class "qm-tile-sub" :halign "start" :xalign 0
          :truncate true :limit-width 13 :text sub)))))

(defwidget qm-connectivity []
  (box :orientation "v" :space-evenly false :spacing 8

    (box :orientation "h" :space-evenly true :spacing 8
      (qm-tile
        :icon {network-data.connection == "wifi-strength-4" ? "wifi-high"
          : network-data.connection == "wifi-strength-3" ? "wifi-medium"
          : network-data.connection == "wifi-strength-2" ? "wifi-low"
          : network-data.connection == "wifi-strength-1" ? "wifi-none"
          : network-data.connection == "wifi-strength-0" ? "wifi-none"
          : network-data.connection == "ethernet-connected" ? "network"
          : "wifi-slash"}
        :title {network-data.connection == "ethernet-connected" ? "Ethernet" : "Wi-Fi"}
        :sub {network-data.connection == "ethernet-connected" ? "Connected"
          : network-data.connection == "wifi-offline" ? "Offline"
          : network-data.ssid != "" ? network-data.ssid : "On"}
        :on {network-data.connection != "wifi-offline"}
        :tooltip "Network — open nmtui"
        :onclick "scripts/open-tui.sh nmtui &")

      (qm-tile
        :icon {bluetooth-data.state == "connected" ? "bluetooth-connected"
          : bluetooth-data.state == "disabled" ? "bluetooth-x"
          : "bluetooth"}
        :title "Bluetooth"
        :sub {bluetooth-data.count > 1 ? "${bluetooth-data.count} devices"
          : bluetooth-data.count == 1 ? bluetooth-data.devices[0].name
          : bluetooth-data.state == "disabled" ? "Off"
          : "On"}
        :on {bluetooth-data.state != "disabled"}
        :tooltip "Bluetooth — open bluetui"
        :onclick "scripts/open-tui.sh bluetui &"))

    ; VPN and DND exist everywhere; backlight and power mode are laptop-only
    ; and share the last row, so on shark that row disappears whole.
    (box :orientation "h" :space-evenly true :spacing 8
      (qm-tile
        :icon {network-data.vpn_active ? "shield-check" : "shield-slash"}
        :title "VPN"
        :sub {network-data.vpn_active ? network-data.vpn_name : "Off"}
        :on {network-data.vpn_active}
        :tooltip "VPN — open nmtui"
        :onclick "scripts/open-tui.sh nmtui &")
      (qm-tile
        :icon {mako-paused == "1" ? "bell-simple-slash" : "bell-simple"}
        :title "Do Not Disturb"
        :sub {mako-paused == "1" ? "On" : "Off"}
        :on {mako-paused == "1"}
        :tooltip "Silence notifications (critical ones still show)"
        :onclick "scripts/toggle-dnd.sh &"))

    (box :orientation "h" :space-evenly true :spacing 8
      :visible {kb-backlight.present || power-mode.present}
      ; outer boxes keep each tile in its column when the other is missing
      (box :hexpand true
        (box :hexpand true :visible {kb-backlight.present}
          (qm-tile
            :icon "keyboard"
            :title "Backlight"
            :sub {kb-backlight.level == 0 ? "Off"
              : kb-backlight.level == kb-backlight.max ? "High"
              : kb-backlight.max == 2 ? "Low"
              : "${kb-backlight.level} of ${kb-backlight.max}"}
            :on {kb-backlight.level > 0}
            :tooltip "Keyboard backlight — click to cycle"
            :onclick "scripts/cycle-kb-backlight.sh &")))
      ; Auto = auto-cpufreq's charger/battery switching; white = forced
      (box :hexpand true
        (box :hexpand true :visible {power-mode.present}
          (qm-tile
            :icon {power-mode.mode == "powersave" ? "leaf"
              : power-mode.mode == "performance" ? "speedometer"
              : "scales"}
            :title "Power mode"
            :sub {power-mode.mode == "powersave" ? "Power saver"
              : power-mode.mode == "performance" ? "Performance"
              : "Auto"}
            :on {power-mode.mode != "auto"}
            :tooltip "Click to cycle: Auto → Power saver → Performance. Back to Auto on reboot."
            :onclick "scripts/power-mode.sh cycle &"))))

    ; Connected bluetooth devices with battery; "–" when a device doesn't
    ; report one (see watch-bluetooth.sh).
    (box :class "qm-bt-devices" :orientation "v" :space-evenly false :spacing 10
      :visible {bluetooth-data.count > 0}
      (for dev in {bluetooth-data.devices}
        (box :orientation "h" :space-evenly false :spacing 10 :halign "fill"
          (image :class "qm-dim-icon" :path {dev.icon} :image-width 16 :image-height 16)
          (label :class "qm-row-label" :halign "start" :hexpand true
            :truncate true :limit-width 26
            :text {dev.name})
          (label :class "qm-row-value" :xalign 1
            :text {dev.battery >= 0 ? "${dev.battery}%" : "–"}))))))

; ── System status: one dot and one word (Idle → Overloaded, from
; sensors.sh). The numbers live in the tooltip; click opens btop.

(defwidget qm-status []
  (button
    :class "qm-status qm-status-${sensors-data.level}"
    :tooltip "CPU ${sensors-data.cpu}% · Memory ${sensors-data.ram}%${sensors-data.cpu_temp > 0 ? " · CPU ${sensors-data.cpu_temp}°" : ""}${sensors-data.gpu_temp > 0 ? " · GPU ${sensors-data.gpu_temp}°" : ""}"
    :onclick "scripts/open-tui.sh btop &"
    (box :orientation "h" :space-evenly false :spacing 10
      (box :class "qm-status-dot" :valign "center")
      (label :class "qm-status-label" :halign "start" :hexpand true :text {sensors-data.status})
      (image :class "qm-dim-icon" :path "icons/caret-right.svg" :image-width 13 :image-height 13))))

; ── Calendar

(defwidget qm-calendar []
  (box
    :class "qm-section qm-calendar"
    :orientation "v"
    :space-evenly false
    :spacing 12

    (box :orientation "h" :space-evenly false :halign "fill" :spacing 0
      (button :class "qm-cal-nav"
        :onclick "scripts/cal-nav.sh prev ${cal-month} ${cal-year} &"
        (image :path "icons/caret-left.svg" :image-width 13 :image-height 13))
      (label :class "qm-cal-header" :hexpand true :halign "center"
        :text {(cal-month == 1  ? "January"
              : cal-month == 2  ? "February"
              : cal-month == 3  ? "March"
              : cal-month == 4  ? "April"
              : cal-month == 5  ? "May"
              : cal-month == 6  ? "June"
              : cal-month == 7  ? "July"
              : cal-month == 8  ? "August"
              : cal-month == 9  ? "September"
              : cal-month == 10 ? "October"
              : cal-month == 11 ? "November"
              : "December") + " " + cal-year})
      (button :class "qm-cal-nav"
        :onclick "scripts/cal-nav.sh next ${cal-month} ${cal-year} &"
        (image :path "icons/caret-right.svg" :image-width 13 :image-height 13)))

    (calendar
      :class "qm-cal"
      :day cal-today
      :month cal-month
      :year cal-year
      :show-details false
      :show-heading false
      :show-day-names true
      :show-week-numbers false)))
