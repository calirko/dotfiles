(defwindow osd-volume
  :monitor 0
  :geometry (geometry
    :x "6px" :y "6px"
    :width "260px"
    :anchor "bottom left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (volume-slider))

(defwindow osd-brightness
  :monitor 0
  :geometry (geometry
    :x "6px" :y "6px"
    :width "260px"
    :anchor "bottom left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (brightness-slider))
