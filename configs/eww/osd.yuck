; Volume / brightness OSD: a small glass card at the bottom of the screen,
; beside the bar. x is measured from the bar's reserved zone, like the menu.

(defwindow osd-volume
  :monitor 0
  :geometry (geometry
    :x "7px" :y "7px"
    :width "280px"
    :anchor "bottom left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-osd"
  (box :class "osd" (volume-slider)))

(defwindow osd-brightness
  :monitor 0
  :geometry (geometry
    :x "7px" :y "7px"
    :width "280px"
    :anchor "bottom left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-osd"
  (box :class "osd" (brightness-slider)))
