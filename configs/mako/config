# ── General ──────────────────────────────
max-visible=3
sort=-time
layer=overlay
anchor=bottom-left

# ── Appearance ───────────────────────────
# Glass, grayscale (same tokens as eww.scss): translucent cards over
# Hyprland blur (^notifications$ layer rule), white-alpha text, no lines.
# Colors are #RRGGBBAA.
background-color=#0e0e0ec7
text-color=#fffffff2
border-size=1
# the card's own glass with a light edge, at the card's alpha: a translucent
# white border (like eww's) falls under the layer rule's ignore_alpha and
# leaves a 1px unblurred ring around the card
border-color=#262626c7
border-radius=15
padding=14,16
# 7px from the bar (x is measured from its reserved zone), from the screen
# bottom and between cards, like windows. mako gives each card only its top
# margin when stacking, so the bottom gap comes from outer-margin; a plain
# margin=7 left the lowest card flush with the screen edge.
margin=7,0,0,7
outer-margin=0,0,7,0
width=360
font=Geist 12
format=<span weight="600">%s</span>\n<span alpha="70%%">%b</span>

# ── Icons ────────────────────────────────
icons=1
max-icon-size=32
icon-border-radius=5
icon-location=left
icon-path=/home/calirko/.local/share/icons/WhiteSur-grey-dark:/usr/share/icons/Adwaita:/usr/share/icons/hicolor

# ── Behavior ─────────────────────────────
default-timeout=5000
ignore-timeout=0
group-by=app-name

# Repeats from one app still collapse into a single card, but without mako's
# default "(N)" counter on grouped cards.
[grouped]
format=<span weight="600">%s</span>\n<span alpha="70%%">%b</span>

# ── Urgency: low ─────────────────────────
[urgency=low]
text-color=#ffffffad

# ── Urgency: normal ──────────────────────
[urgency=normal]
text-color=#fffffff2

# ── Urgency: critical ────────────────────
# The white "on" style from the quick menu, so it can't be missed.
[urgency=critical]
background-color=#ffffffeb
text-color=#161616
border-color=#ffffffeb

# ── Suppressed apps ───────────────────────
# Check actual app-name with: makoctl list | grep app-name
[app-name=wiki]
invisible=1

[app-name=peer]
invisible=1

[app-name=NetworkManager summary~=peer*]
invisible=1

# ── Do not disturb ───────────────────────
# Toggled by the quick menu (eww/scripts/toggle-dnd.sh). Without this
# section the mode switches but nothing is hidden. Critical still gets through.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
