[Unit]
Description=Lid switch handler for Hyprland (raccoon)
# Hyprland is launched from ~/.zprofile, not a systemd-managed session, so
# graphical-session.target is never kept active. Bind to default.target (always
# reached at user login) instead; the handler script self-waits for the
# Hyprland socket before issuing any hyprctl commands.

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/lid-handler.sh
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
